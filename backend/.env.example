# Binance demo API key/secret (from demo.binance.com API Management, GitHub OAuth).
# On Render set these as environment variables; never commit real values.
THUNDOC_BINANCE_KEY=
THUNDOC_BINANCE_SECRET=

# --- FREE AI second-opinion for trade decisions (no paid plan required) ---
# The bot asks a free LLM to CONFIRM/REJECT its technical signal before
# risking capital. Add ANY ONE of these free tokens (none = local heuristic).
# Get free in ~30s, no card:
#   OpenRouter:  https://openrouter.ai/keys   (model: meta-llama/llama-3.1-8b-instruct:free)
#   Groq:        https://console.groq.com/keys (model: llama-3.1-8b-instant)
#   HuggingFace: https://huggingface.co/settings/tokens
OPENROUTER_API_KEY=
GROQ_API_KEY=
HF_TOKEN=
# Optional: override the default free model names
# AI_MODEL=meta-llama/llama-3.1-8b-instruct:free
# GROQ_MODEL=llama-3.1-8b-instant
